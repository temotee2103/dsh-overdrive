# dsh-overdrive environment — copy to .env:  cp deploy/.env.example .env
# 必填 Required: DEEPSEEK_API_KEY
# 平台凭据按需 Platform credentials only if you use the platform.

# ── Model / 模型 ───────────────────────────────────────────────
DEEPSEEK_API_KEY=
# DSH gateway 与 dsh 之间的通信 token（自用即可，改不改都行）
DSH_OVERDRIVE_TOKEN=dev-token

# ── Platforms / 平台（按需填写）────────────────────────────────
# Telegram: 与 @BotFather 创建 bot 后拿 token
GATEWAY_ADAPTERS=telegram
TELEGRAM_BOT_TOKEN=
# WhatsApp: 留空，首次启动扫码配对（数据保存在 ./data/whatsapp）
WHATSAPP_DATA_DIR=/data/whatsapp
# Discord
DISCORD_BOT_TOKEN=
# Slack (Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# 飞书 Feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 钉钉 DingTalk
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 企业微信 WeCom
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_AGENT_ID=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# ── Access / 访问控制（可选）────────────────────────────────────
# 白名单：逗号分隔的 platform:channelId:userId（留空=允许所有）
ALLOWLIST=
